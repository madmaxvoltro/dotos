# Dot kiosk: sway with no bar, no shortcuts and every window full screen.
# Monitors are arranged by dotd (Settings > Screen), which writes sway-outputs.conf.

# no error bars, no borders, no title bars
swaynag_command -
default_border none
default_floating_border none
titlebar_border_thickness 0
titlebar_padding 1
focus_on_window_activation focus
focus_follows_mouse no
mouse_warping none
output * bg #000000 solid_color

# keyboard layout from Settings > This Dot (dotd also applies changes live)
include /var/lib/dot/sway-input.conf

# monitor arrangement, modes and rotation
include /var/lib/dot/sway-outputs.conf

# the Dot UI and the idle clocks always fill their monitor
for_window [title="^Dot$"] fullscreen enable
for_window [title="^Dot Clock$"] fullscreen enable
# the Remote Desktop session fills its monitor and comes to the front (Dot's own screen is full screen too)
for_window [title="Dot Session"] fullscreen enable, focus
for_window [app_id="dot-terminal"] fullscreen enable, focus
for_window [app_id="(?i)freerdp"] fullscreen enable, focus
for_window [class="(?i)(freerdp|dot-session)"] fullscreen enable, focus
# game mode: Moonlight fills the main monitor (dotd focuses it before starting)
for_window [app_id="com.moonlight_stream.Moonlight"] fullscreen enable
# mirror mode copies the main monitor onto the others
for_window [app_id="at.yrlf.wl_mirror"] fullscreen enable

# the only key binding: Dot's menu during a session (--inhibited: it works even while Remote Desktop
# has the keyboard). Disconnect, sound, back to Windows.
bindsym --inhibited --no-repeat Ctrl+Alt+Shift+d exec curl -fs -X POST http://127.0.0.1:7777/api/session/menu

exec /usr/lib/dot/system/session.sh
