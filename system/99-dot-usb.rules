# Mount USB sticks under /media/dot/<label> so FreeRDP can pass them to the server (Settings > USB drives).
ACTION=="add", SUBSYSTEMS=="usb", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat|ntfs|ntfs3", RUN{program}+="/usr/bin/systemd-mount --no-block --automount=yes --collect -o uid=dot,gid=dot,umask=007 $devnode /media/dot/%E{ID_FS_LABEL}"
ACTION=="add", SUBSYSTEMS=="usb", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}!="vfat|exfat|ntfs|ntfs3", RUN{program}+="/usr/bin/systemd-mount --no-block --automount=yes --collect $devnode /media/dot/%E{ID_FS_LABEL}"
